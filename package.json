{
  "name": "ratchet",
  "version": "0.1.0",
  "scripts": {
    "build": "node scripts/compile.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "chain": "hardhat node --port 8545",
    "demo": "node demo/run.js",
    "deploy": "node scripts/deploy.js",
    "keygen": "node scripts/keygen.js",
    "demo:service": "node demo/service.js",
    "serve": "node service/server.js",
    "demo:verdict": "node demo/verdict.js",
    "serve:x402": "node service/x402-server.js",
    "deploy:arc": "node scripts/deploy-arc.js",
    "verify": "node scripts/verify-job.js",
    "live:arc": "node --env-file=.env demo/live-arc.js",
    "setup:roles": "node --env-file=.env scripts/setup-roles.js",
    "pay:x402": "node --env-file=.env demo/pay-x402.js",
    "evaluator": "node --env-file=.env evaluator/daemon.js",
    "arbiter": "node --env-file=.env arbiter/server.js",
    "live:arbiter": "node --env-file=.env demo/live-arbiter.js",
    "sim:mainnet": "node scripts/sim-mainnet.js",
    "mandate:mcp": "node mandate/mcp-server.js",
    "deploy:mandate": "node --env-file=.env scripts/deploy-mandate.js",
    "agent:fx": "node --env-file=.env agents/fx-reversion.js",
    "arena": "node --env-file=.env arena/server.js",
    "deploy:testnet": "node --env-file=.env scripts/deploy-testnet.js",
    "seed:testnet": "node --env-file=.env scripts/seed-testnet-pool.js",
    "live:testnet": "node --env-file=.env scripts/live-testnet.js",
    "app": "node --env-file=.env app/server.js",
    "feed:publish": "node --env-file=.env scripts/publish-feed.js",
    "bridge": "node --env-file=.env bridge/server.js",
    "build:onramp": "esbuild scripts/onramp-client.js --bundle --format=iife --global-name=CircleOnramp --platform=browser --target=es2019 --minify --legal-comments=eof --outfile=app/public/vendor/onramp-kit.js"
  },
  "license": "MIT",
  "description": "A neutral evaluator for ERC-8183 agent jobs on Arc, built on a metered code sandbox.",
  "dependencies": {
    "@circle-fin/onramp-kit": "1.0.2",
    "@circle-fin/x402-batching": "^3.5.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@openzeppelin/contracts": "^5.6.1",
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "express": "^4.22.3",
    "hardhat": "^2.29.1",
    "solc": "^0.8.28",
    "viem": "^2.56.8",
    "zod": "^3.25.76"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/server.js",
    "./client": "./src/client.js",
    "./voucher": "./src/voucher.js",
    "./vault": "./src/vault.js",
    "./usdc": "./src/usdc.js",
    "./sandbox": "./src/sandbox.js",
    "./evaluator": "./evaluator/index.js",
    "./x402": "./service/x402.js"
  },
  "files": [
    "src",
    "service",
    "evaluator",
    "contracts",
    "build",
    "scripts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
