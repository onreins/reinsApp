    "viem": "^2.56.8"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/server.js",
    "./client": "./src/client.js",
    "./voucher": "./src/voucher.js",
    "./vault": "./src/vault.js",
    "./usdc": "./src/usdc.js",
    "./sandbox": "./src/sandbox.js",
    "./evaluator": "./evaluator/index.js"
  },
  "files": [
    "src",
    "service",
    "evaluator",
    "contracts",
    "build",
    "scripts",
    "README.md"
